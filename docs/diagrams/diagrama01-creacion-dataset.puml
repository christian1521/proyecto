@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 9
skinparam ActivityPadding 2
skinparam ActivityBorderThickness 0.6
skinparam ArrowThickness 0.6
skinparam dpi 300

start
repeat
  :SEMILLAS (ARXIV-ID);
  :DESCARGA FUENTES LATEX;
  :EXTRACCIÓN DE TARBALLS;
  :CONTENIDOS Y CITAS;
  :RENOMBRADO ID+CATEGORÍA.TEX;
  :LIMPIEZA LATEX;
  :EXTRACCIÓN SEMÁNTICA DE CITAS;
  :PRECLASIFICACIÓN MANUAL/AUTOMÁTICA;
  backward:IDENTIFICAR CATEGORÍAS CLAVE;
repeat while (¿BALANCEADO?) is (No) not (Sí)
:GENERACIÓN DEL DATASET;
:ENTRENAMIENTO DE MODELOS;
stop
@enduml